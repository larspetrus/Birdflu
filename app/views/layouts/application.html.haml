!!!
%html
  %head
    - if Rails.env.production?
      %script{async: true, src: "https://www.googletagmanager.com/gtag/js?id=G-TT680FBWPT"}
      :javascript
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-TT680FBWPT');
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title Birdflu 1.0 β-ish
    = stylesheet_link_tag    'vendor', media: 'all'
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application'
    = csrf_meta_tags
    = favicon_link_tag 'favicon.ico'
  %body
    - flash.each do |name, msg|
      = content_tag :div, msg, class: "flash_msgs"
    = yield

    .login{class: @dev_marker_class}
      - if @login
        #{@login.name}
        .logout
          = link_to 'Logout', wca_logout_path
      - else
        - if ENV['WCA_OAUTH_CLIENT_SECRET']
          %a{href: OauthController::WCA_LOGIN_URL}
            WCA Login
        - else
          = link_to 'Fake Login', fake_wca_login_path

    :javascript
      setTimeout("$('.flash_msgs').fadeOut(2000)", 5000)

